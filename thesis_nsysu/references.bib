@article{Pozar2012,
   abstract = {Fourth edition. The 4th edition of this classic text provides a thorough coverage of RF and microwave engineering concepts, starting from fundamental principles of electrical engineering, with applications to microwave circuits and devices of practical importance. Coverage includes microwave network analysis, impedance matching, directional couplers and hybrids, microwave filters, ferrite devices, noise, nonlinear effects, and the design of microwave oscillators, amplifiers, and mixers. Material on microwave and RF systems includes wireless communications, radar, radiometry, and radiation hazards. A large number of examples and end-of-chapter problems test the reader's understanding of the material. The 4th edition includes new and updated material on systems, noise, active devices and circuits, power waves, transients, RF CMOS circuits, and more. Electromagnetic theory -- Transmission line theory -- Transmission lines and waveguides -- Microwave network analysis -- Impedance matching and tuning -- Microwave resonators -- Power dividers and directional couplers -- Microwave filters -- Theory and design of ferrimagnetic components -- Noise and nonlinear distortion -- Active RF and microwave devices -- Microwave amplifier design -- Oscillators and mixers -- Introduction to microwave systems.},
   author = {David M.. Pozar},
   isbn = {978-1-118-21363-6},
   pages = {756},
   publisher = {Wiley},
   title = {Microwave engineering},
   url = {https://www.wiley.com/en-us/Microwave+Engineering%2C+4th+Edition-p-9781118213636},
   year = {2012}
}
@article{Ding2021,
   abstract = {The automotive radar plays an important role in the field of advanced driver assistant systems (ADASs), the detection for unmanned aerial vehicles (UAV), etc. However, most automotive radar products can only estimate the azimuth, and it is necessary for automatic driving technology to acquire the height information. In this paper, we propose a signal processing algorithm based on the 2D sparse multiple-input and multiple-output (MIMO) antenna array, which can detect the range, the velocity, the azimuth, and the elevation of target scatters respect to the radar, and those information can form a clear point-cloud image. The 2D hybrid sparse receiver array is firstly designed with the advantage of reducing the hardware resources, such as the number of transceiver channels. Sequentially, through the fast algorithm of 2D-FFT digital beamforming (DBF), the matrix completion (MC) and the correction of motion-induced phase by the switch delay of the time-division MIMO (TDM-MIMO), the azimuth and elevation of scatters can be presented. Finally, the experiment validates that a point-cloud image like lidar can be presented by the algorithm we propose.},
   author = {Jieru Ding and Wendan Ma and Zhiyi Wang and Hailong Kang and Min Wang},
   doi = {10.1109/RADAR53847.2021.10028211},
   isbn = {9781665498142},
   issn = {23755318},
   journal = {Proceedings of the IEEE Radar Conference},
   keywords = {ADASs,DBF,FFT,TDM-MIMO radar,UAV,the automotive radar},
   pages = {2838-2842},
   publisher = {Institute of Electrical and Electronics Engineers Inc.},
   title = {Automotive radar 4D Point-cloud Imaging with 2D Sparse Array},
   volume = {2021-December},
   year = {2021}
}
@article{Melvin2014,
   abstract = {This third and final volume in the Principles of Modern Radar series brings all the fundamentals and advanced techniques of the prior volumes to their logical conclusion by presenting the applications of radar. This unique book provides in-depth discussions of the most important areas in current radar practice, serving primarily radar practitioners and advanced graduate students. For those needing to become experts in an advanced technology or application area, Radar Applications should be the foundation of their research before they tackle in-depth, single topic advanced books and literature. These advanced books are suggested at the end of each chapter to guide readers toward the best published works. Principles of Modern Radar: Radar Applications provides concise descriptions of the purposes, principal issues, and radar methods found in a wide variety of current radar types with military, commercial, and civilian uses. These types of radar include continuous wave (CW) radar, weather and air traffic control, pulse Doppler, fire control, ground moving target indication, and unconventional applications such as materials and ground penetrating radar. This book combines the best attributes of edited and single-author references. It draws on the expertise of authors from academia and industry, active in both teaching and ongoing research. These specialists provide greater depth and experience over the broad range of radar topics than could any single author. As with the entire Principles of Modern Radar series, this book was community reviewed by experts from around the world for coherence and consistency.},
   author = {William L. Melvin and James A. Scheer},
   doi = {10.1049/SBRA503E;WEBSITE:WEBSITE:IET-SITE;JOURNAL:JOURNAL:BOOKS;WGROUP:STRING:PUBLICATION},
   isbn = {9781613530320},
   journal = {Principles of Modern Radar: Vol. III: Radar Applications},
   keywords = {Air traffic control radar,Airborne pulse-Doppler radar,Ballistic missile defense radar,Continuous wave radar,Fire-control radar,Foliage-penetrating radar,GBEWR,Ground-based early warning radar,Ground-penetrating radar,MMW radar applications,MMW radar characteristics,Modern radar,Multifunction phased array radar systems,Passive bistatic radar,Police radar,Radar applications,Radar signal processing,Remote sensing,Remote sensing by radar,Signal processing algorithms,Space-based SAR,Surface moving target indication,Weather radar},
   month = {1},
   pages = {1-797},
   publisher = {Institution of Engineering and Technology},
   title = {Principles of modern radar: Vol. III: Radar applications},
   year = {2014}
}
@article{Imran2018,
   abstract = {This paper presents a micro strip patch antenna for future 5G-communication technology at centered frequency 38GHz and 54GHz having bandwidth 1.94GHz and 2GHz respectively with low cost substrate and small size patch best suited for miniaturized devices. It consists of Rogers RT5880 (lossy) substrate with dielectric constant 2.2 with loss tangent of 0.0013 and standard thickness 0.508mm, PEC patch and PEC ground. Substrate of dimensions 6mm×6.25mm and patch with dimensions 2mm×2mm is used. Microstrip-line feeding technique is used. Array having 4 elements with 4mm spacing has been proposed to achieve 12 dB gain for mobile data Applications on millimeter wave frequencies at 38.6GHz, 47.7GHz and 54.3GHz having bandwidth 3.5GHz, 2.5GHz and 1.3GHz respectively with Tapered line feeding. Overall size of antenna is 6mm×6.25mm×0.578mm. The proposed Antenna design is simulated on CST Microwave Studio.},
   author = {D. Imran and M. M. Farooqi and M. I. Khattak and Z. Ullah and M. I. Khan and M. A. Khattak and H. Dar},
   doi = {10.1109/ICEET1.2018.8338623},
   isbn = {9781538621707},
   journal = {2018 International Conference on Engineering and Emerging Technologies, ICEET 2018},
   keywords = {5G,Array,Micro strip line,Millimeter wave,Tapered line feeding and CST},
   month = {4},
   pages = {1-6},
   publisher = {Institute of Electrical and Electronics Engineers Inc.},
   title = {Millimeter wave microstrip patch antenna for 5G mobile communication},
   volume = {2018-January},
   year = {2018}
}
@article{Liu2023,
   abstract = {This brief introduces a compact, cost-effective broadband patch antenna based on ball grid array (BGA) packaging technology for 5G millimeter wave new radio (NR) FR2 band application. Based on the low-cost FR-4 substrate and single-layer configuration, the patch antenna achieves an ultra-low cost, which is attractive for large-scale 5G millimeter-wave array applications. Parasitic patches are added to the antenna to obtain broadband impedance bandwidth. To further reduce the antenna size and eliminate bulky connectors, solder balls are added to form a BGA package with connectorless interconnects. Consequently, the proposed antenna element achieves a compact size of 5.2 mm × 3.2 mm × 1.4 mm. Antenna elements and 1 × 8 array prototypes have been fabricated and verified. The measurement results show that the proposed antenna element has a -10 dB bandwidth of 56.1% (20-35.6 GHz), fully covering the 5G millimeter wave n257 (26.5-29.5 GHz), n258 (24.25-27.5 GHz), and n261 (27.5-28.35 GHz) bands. The maximum realized gains of the antenna elements and the 1 × 8 array prototype are 7.2 dBi and 13.9 dBi, respectively.},
   author = {Xiubo Liu and Wei Zhang and Dongning Hao and Yanyan Liu},
   doi = {10.1109/TCSII.2022.3233381},
   issn = {15583791},
   issue = {6},
   journal = {IEEE Transactions on Circuits and Systems II: Express Briefs},
   keywords = {5G millimeter-wave,FR2 bands,ball grid array (BGA) packaging,broadband antenna,patch antennas,surface-mount components},
   month = {6},
   pages = {1921-1925},
   publisher = {Institute of Electrical and Electronics Engineers Inc.},
   title = {Cost-Effective Broadband and Compact Patch Antenna Based on Ball Grid Array Packaging for 5G NR FR2 Band Applications},
   volume = {70},
   year = {2023}
}
@article{Sim2023,
   abstract = {A broadband coplanar feed patch antenna for 5G millimeter-wave (mmWave) applications is initially studied. To achieve good beam scanning/steering characteristics, the single-patch antenna element design is applied to form a 1 × 4 antenna array with a gap distance (center-to-center) of 6 mm (about 0.5 λ0 at 25 GHz) between two adjacent antenna elements. To achieve better impedance matching (broad bandwidth) and isolation level, four sets of 2 × 3 parasitic square array patches are also loaded into the proposed 1 × 4 antenna array. The measured overlapped 10 dB impedance bandwidth of the proposed 1 × 4 antenna array was 28% (23-30.5 GHz), which can cover the 5G NR (new radio) bands n257/n258/n261 (24.25-29.5 GHz). Across the bands of interest, the isolation between any two adjacent array elements is greater than 16 dB with a maximum gain of 9.76 dBi and total efficiency >68%. Even though the overall size of the proposed 1 × 4 antenna array is 26 × 5 × 1.524 mm, a wide range of beam scanning angles covering ±40° can still be obtained at 27 GHz.},
   author = {Chow Yen Desmond Sim and Jeng Jr Lo and Zhi Ning Chen},
   doi = {10.1109/LAWP.2022.3231358},
   issn = {15485757},
   issue = {5},
   journal = {IEEE Antennas and Wireless Propagation Letters},
   keywords = {1 × 4 antenna array,5G millimeter-wave (mmWave) antenna,antenna-in-package (AiP),beam scanning},
   month = {5},
   pages = {1030-1034},
   publisher = {Institute of Electrical and Electronics Engineers Inc.},
   title = {Design of a Broadband Millimeter-Wave Array Antenna for 5G Applications},
   volume = {22},
   year = {2023}
}
@article{Lopez2019,
   abstract = {The realization of a seamless, fully connected world requires enhancements to our current communications technology, from both a network infrastructure perspective and a user equipment (UE) perspective. These demands are directly driven by the consumer's expectations, application requirements, and saturation of frequency bands used in current spectrum. The fifth generation (5G) of mobile communication networks, and specifically millimeter-wave (mmWave) New Radio (NR), aims to enable this future with ultra-low-latency, ultra-wideband services, opening up a whole new era of applications and services, much like 4G Long Term Evolution (LTE) did a decade ago. To enable 5G, the Third Generation Partnership Project (3GPP) is focusing on defining the technical specifications for NR technology, as well as enhancements to the current LTE. However, enabling and launching 5G NR presents both technological opportunities and challenges. In this column, we explore how 5G mmWave challenges are being approached in 3GPP standardization and how solutions can enable the technology to help achieve broader bandwidths and harness some of the inherent benefits of higher-frequency communications.},
   author = {Aida Vera Lopez and Andrey Chervyakov and Greg Chance and Sumit Verma and Yang Tang},
   doi = {10.1109/MWC.2019.8700132},
   issn = {15580687},
   issue = {2},
   journal = {IEEE Wireless Communications},
   month = {4},
   pages = {4-6},
   publisher = {Institute of Electrical and Electronics Engineers Inc.},
   title = {Opportunities and challenges of mmWave NR},
   volume = {26},
   year = {2019}
}
@article{ConstantineABalanis2016,
   abstract = {This book introduces the fundamental principles of antenna theory and explains how to apply them to the analysis, design, and measurements of antennas. Due to the variety of methods of analysis and design, and the different antenna structures available, the applications covered in this book are made to some of the most basic and practical antenna configurations. Among these antenna configurations are linear dipoles; loops; arrays; broadband antennas; aperture antennas; horns; microstrip antennas; and reflector antennas. The text contains sufficient mathematical detail to enable undergraduate and beginning graduate students in electrical engineering and physics to follow the flow of analysis and design. Readers should have a basic knowledge of undergraduate electromagnetic theory, including Maxwell’s equations and the wave equation, introductory physics, and differential and integral calculu},
   author = {Constantine A. Balanis},
   isbn = {978-1-118-64206-1},
   pages = {1104},
   publisher = {Wiley},
   title = {ANTENNA THEORY ANALYSIS AND DESIGN 4TH EDITION C2016.pdf},
   url = {https://www.wiley.com/en-us/Antenna+Theory%3A+Analysis+and+Design%2C+4th+Edition-p-9781118642061},
   year = {2016}
}
@article{Achouri2021,
   abstract = {In Electromagnetic Metasurfaces: Theory and Applications, distinguished researchers and authors Karim Achouri and Christophe Caloz deliver an introduction to the fundamentals and applications of metasurfaces and an insightful analysis of recent and future developments in the field. The book describes the precursors and history of metasurfaces before continuing on to an exploration of the physical insights that can be gleaned from the material parameters of the metasurface. You’ll learn how to compute the fields scattered by a metasurface with known material parameters being illuminated by an arbitrary incident field, as well as how to realize a practical metasurface and relate its material parameters to its physical structures. The authors provide examples to illustrate all the concepts discussed in the book to improve and simplify reader understanding. Electromagnetic Metasurfaces concludes with an incisive discussion of the likely future directions and research opportunities in the field. Readers will also benefit from the inclusion of: A thorough introduction to metamaterials, the concept of metasurfaces, and metasurface precursors An exploration of electromagnetic modeling and theory, including metasurfaces as zero-thickness sheets and bianisotropic susceptibility tensors A practical discussion of susceptibility synthesis, including four-parameters synthesis, more than four-parameters synthesis, and the addition of susceptibility components A concise treatment of scattered-field analysis, including approximate analytical methods, and finite-difference freque cy-domain techniques Perfect for researchers in metamaterial sciences and engineers working with microwave, THz, and optical technologies, Electromagnetic Metasurfaces: Theory and Applications will also earn a place in the libraries of graduate and undergraduate students in physics and electrical engineering.},
   author = {Karim Achouri and Christophe Caloz},
   doi = {10.1002/9781119525219},
   isbn = {9781119525219},
   journal = {Electromagnetic Metasurfaces: Theory and Applications},
   month = {1},
   pages = {1-201},
   publisher = {wiley},
   title = {Electromagnetic Metasurfaces: Theory and Applications},
   url = {https://onlinelibrary.wiley.com/doi/book/10.1002/9781119525219},
   year = {2021}
}
